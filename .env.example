PORT=4321
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://uuapi.net/v1
OPENAI_API_KEY=replace-with-your-key
DASHSCOPE_API_KEY=replace-with-your-qwen-realtime-key
DASHSCOPE_WORKSPACE_ID=replace-with-your-workspace-id
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COACH_AI_MODEL=qwen3.7-max
# Optional overrides. By default AI Coach uses DASHSCOPE_API_KEY and DASHSCOPE_COMPAT_BASE_URL.
COACH_AI_BASE_URL=
COACH_AI_API_KEY=
WRITING_AI_MODEL=qwen3.7-max
# Optional override. By default writing feedback uses DASHSCOPE_API_KEY and DASHSCOPE_COMPAT_BASE_URL.
WRITING_AI_API_KEY=
WRITING_AI_BASE_URL=
SPEAKING_AUDIO_AI_MODEL=qwen3.5-omni-flash
# Optional override. By default speaking MP3 scoring uses DASHSCOPE_API_KEY and DASHSCOPE_COMPAT_BASE_URL.
SPEAKING_AUDIO_AI_API_KEY=
SPEAKING_AUDIO_AI_BASE_URL=
# Base64 byte limit for MP3 evidence sent to the speaking scoring model.
SPEAKING_AUDIO_MAX_BASE64_BYTES=10000000
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
# auto: try WebRTC first; off: skip WebRTC and use WebSocket fallback directly.
QWEN_WEBRTC_MODE=auto
# Optional: override when Aliyun gives you a dedicated WebRTC endpoint.
# Defaults to https://{DASHSCOPE_WORKSPACE_ID}.{DASHSCOPE_REGION}.maas.aliyuncs.com
DASHSCOPE_WEBRTC_ENDPOINT=
# Optional: send only the SDP exchange to a supported-region proxy.
# The browser still uses WebRTC media directly after the answer SDP is returned.
QWEN_WEBRTC_EXCHANGE_PROXY_URL=
FISH_API_KEY=replace-with-your-fish-audio-key
IELTSIST_DB_PATH=./data/ieltsist.sqlite
# Used by external automation, for example a Xianyu fulfillment bot, to create week/month/year redemption codes.
ADMIN_API_SECRET=replace-with-a-long-random-admin-secret
# Long random value shared only with STEM Campus. It signs five-minute account handoff tokens;
# it is never exposed to browsers, Git, or a student API response.
STEM_IDENTITY_SIGNING_KEY=replace-with-a-long-random-shared-secret
# Structured STEM marking is configured only on IELTSist; never expose values to STEM browsers.
STEM_MARKING_AI_MODEL=
STEM_MARKING_AI_BASE_URL=
STEM_MARKING_AI_API_KEY=
# Set to 1 during rollout or an outage: returns safe 503 without queueing a marking job.
STEM_MARKING_AI_DISABLED=0
